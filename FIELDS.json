    "min": 10,
    "max": 1000,
    "step": 10,
    "group": "04 // CHAT"
  },
  "commandEnabled": {
    "type": "checkbox",
    "label": "Enable Companion Command",
    "value": true,
    "group": "04 // CHAT"
  },
  "command": {
    "type": "text",

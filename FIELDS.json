{
  "widgetName": {
    "type": "hidden",
    "value": "CIGA Companion"
  },
  "enabled": {
    "type": "checkbox",
    "label": "Enabled",
    "value": true,
    "group": "01 // COMPANION"
  },
  "showHelpTips": {
    "type": "checkbox",
    "label": "Show Help Tips In Widget",
    "value": true,
    "group": "01 // COMPANION"
  },
  "helpNotice": {
    "type": "text",
    "label": "ℹ️ Changes require SAVE before they take effect",
    "value": "Use the Help Tips for a quick guide to Companion features and custom responses.",
    "group": "01 // COMPANION"
  },
  "companionName": {
    "type": "text",
    "label": "Companion Name",
    "value": "COMPANION",
    "group": "01 // COMPANION"
  },
  "petImage": {
    "type": "image-input",
    "label": "Companion Image — PNG / JPG / GIF",
    "group": "01 // COMPANION"
  },
  "petSize": {
    "type": "slider",
    "label": "Image Size — base size",
    "value": 180,
    "min": 30,
    "max": 1000,
    "step": 5,
    "group": "01 // COMPANION"
  },
  "petScale": {
    "type": "slider",
    "label": "Image Scale — visual multiplier",
    "value": 1,
    "min": 0.25,
    "max": 3,
    "step": 0.05,
    "group": "01 // COMPANION"
  },
  "idleDistance": {
    "type": "slider",
    "label": "Idle Breathing Amount",
    "value": 5,
    "min": 0,
    "max": 50,
    "step": 1,
    "group": "01 // COMPANION"
  },
  "shadowEnabled": {
    "type": "checkbox",
    "label": "Enable Shadow",
    "value": true,
    "group": "02 // SHADOW"
  },
  "shadowOpacity": {
    "type": "slider",
    "label": "Shadow Opacity",
    "value": 0.28,
    "min": 0,
    "max": 1,
    "step": 0.01,
    "group": "02 // SHADOW"
  },
  "shadowBlur": {
    "type": "slider",
    "label": "Shadow Blur",
    "value": 5,
    "min": 0,
    "max": 40,
    "step": 1,
    "group": "02 // SHADOW"
  },
  "shadowScaleX": {
    "type": "slider",
    "label": "Shadow Width",
    "value": 0.88,
    "min": 0.1,
    "max": 3,
    "step": 0.02,
    "group": "02 // SHADOW"
  },
  "shadowScaleY": {
    "type": "slider",
    "label": "Shadow Height",
    "value": 0.18,
    "min": 0.02,
    "max": 1,
    "step": 0.01,
    "group": "02 // SHADOW"
  },
  "shadowOffsetY": {
    "type": "slider",
    "label": "Shadow Vertical Offset",
    "value": 7,
    "min": -100,
    "max": 200,
    "step": 1,
    "group": "02 // SHADOW"
  },
  "randomSpeechEnabled": {
    "type": "checkbox",
    "label": "Random Speech Enabled",
    "value": true,
    "group": "03 // RANDOM SPEECH"
  },
  "randomSpeechMinSec": {
    "type": "slider",
    "label": "Minimum Interval",
    "value": 30,
    "min": 1,
    "max": 600,
    "step": 1,
    "group": "03 // RANDOM SPEECH"
  },
  "randomSpeechMaxSec": {
    "type": "slider",
    "label": "Maximum Interval",
    "value": 90,
    "min": 1,
    "max": 600,
    "step": 1,
    "group": "03 // RANDOM SPEECH"
  },
  "randomLines": {
    "type": "text",
    "label": "Random Lines — use | between lines",
    "value": "I'm watching.|Did someone say something?|I'm hungry.|What are we doing?|Interesting...|I'm here.|...",
    "group": "03 // RANDOM SPEECH"
  },
  "greetingEnabled": {
    "type": "checkbox",
    "label": "Greeting Responses",
    "value": true,
    "group": "04 // CHAT"
  },
  "greetingTriggers": {
    "type": "text",
    "label": "Greeting Triggers — use | between",
    "value": "hello|hi|hey|good morning|good afternoon|good evening",
    "group": "04 // CHAT"
  },
  "greetingResponses": {
    "type": "text",
    "label": "Greeting Responses — {user} = viewer name",
    "value": "Hello, {user}!|Hi, {user}!|Hey, {user}!|Hello {user}.|Hey {user}, welcome!",
    "group": "04 // CHAT"
  },
  "greetingCooldownSec": {
    "type": "slider",
    "label": "Greeting Cooldown",
    "value": 5,
    "min": 0,
    "max": 120,
    "step": 1,
    "group": "04 // CHAT"
  },
  "queueLimit": {
    "type": "slider",
    "label": "Maximum Speech Queue",
    "value": 3,
    "min": 1,
    "max": 20,
    "step": 1,
    "group": "04 // CHAT"
  },
  "maxMessageCharacters": {
    "type": "slider",
    "label": "Maximum Chat Message Characters",
    "value": 120,
    "min": 10,
    "max": 500,
    "step": 5,
    "group": "04 // CHAT"
  },
  "maxBubbleCharacters": {
    "type": "slider",
    "label": "Maximum Bubble Characters — does NOT limit TTS",
